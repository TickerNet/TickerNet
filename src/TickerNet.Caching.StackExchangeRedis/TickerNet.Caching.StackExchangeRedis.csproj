<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageId>TickerNet.Caching.StackExchangeRedis</PackageId>
        <Title>TickerNet StackExchange.Redis Caching</Title>
        <Description>Redis caching and distributed synchronization provider for TickerNet job scheduler using StackExchange.Redis</Description>
        <PackageTags>$(PackageTags);Redis;Caching;Distributed;StackExchange</PackageTags>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
      <EmbeddedResource Include="Scripts\*.lua" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="$(DotNetVersion)" />
      <PackageReference Include="TickerNet.Utilities" Version="$(Version)" />
    </ItemGroup>
</Project>
